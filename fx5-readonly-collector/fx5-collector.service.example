[Unit]
Description=Read-only Mitsubishi FX5 production data collector
Documentation=file:///home/piyush/Documents/Codex/2026-10-13/referenced-chatgpt-conversation-this-is-an-2/fx5-readonly-collector/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/piyush/Documents/Codex/2026-10-13/referenced-chatgpt-conversation-this-is-an-2/fx5-readonly-collector
ExecStart=/usr/bin/python3 /home/piyush/Documents/Codex/2026-10-13/referenced-chatgpt-conversation-this-is-an-2/fx5-readonly-collector/fx5_collector.py --config /home/piyush/Documents/Codex/2026-10-13/referenced-chatgpt-conversation-this-is-an-2/fx5-readonly-collector/modules.json --confirm-read-only
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/piyush/Documents/Codex/2026-10-13/referenced-chatgpt-conversation-this-is-an-2/fx5-readonly-collector/data

[Install]
WantedBy=default.target
